<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="CrossBrowser">

    <test name="Chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="tests.NewTabTest"/>
             <class name="tests.AlertTests"/>
              <class name="tests.DoubleClickTest"/>
               <class name="tests.DragAndDropTest"/>
                <class name="tests.FileUploadTest"/>
                 <class name="tests.GUIElementTests"/>
                  <class name="tests.LinkLabelsTest"/>
                  <class name="tests.MouseHoverTest"/>
        </classes>
    </test>

    <test name="Edge">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="tests.NewTabTest"/>
             <class name="tests.AlertTests"/>
              <class name="tests.DoubleClickTest"/>
               <class name="tests.DragAndDropTest"/>
                <class name="tests.FileUploadTest"/>
                 <class name="tests.GUIElementTests"/>
                 <class name="tests.LinkLabelsTest"/>
                 <class name="tests.MouseHoverTest"/>
                
        </classes>
    </test>

</suite>